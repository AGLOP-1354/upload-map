# 업로드맵 로그인 계정 (1인용). 이 파일을 .env.local 로 복사해 값을 채운다.
ADMIN_ID=
ADMIN_PASSWORD=
# 세션 쿠키 서명 키. 32자 이상 무작위 문자열: openssl rand -hex 32
SESSION_SECRET=

# 원격 MCP(/api/mcp) Bearer 토큰. 비어 있으면 MCP 요청을 모두 거부한다: openssl rand -hex 32
MCP_TOKEN=

# 저장 백엔드. 비우면 로컬 파일(fs). 배포(Vercel)에서는 github 로 두고 아래 세 값을 채운다.
DATA_STORE=
# 이 저장소 하나에 Contents 읽기/쓰기만 준 fine-grained PAT
GITHUB_TOKEN=
GITHUB_REPO=AGLOP-1354/upload-map
# Vercel Production 브랜치와 같아야 한다 (기본값 없음)
GITHUB_BRANCH=
