{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm run wiki:*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint *)",
      "Bash(node .claude/skills/*)",
      "Bash(cat .next/dev/lock)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Read(./node_modules/next/dist/docs/**)",
      "mcp__next-devtools__*"
    ],
    "ask": [
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(git push*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf data*)",
      "Bash(rm -rf content*)",
      "Bash(rm -r data*)",
      "Bash(rm -r content*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/wiki.mjs\" hook-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/wiki.mjs\" hook-post",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.claude/hooks/post-edit-check.mjs\"",
            "timeout": 90
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/wiki.mjs\" hook-stop",
            "timeout": 30,
            "statusMessage": "LLM Wiki 검증 중"
          }
        ]
      }
    ]
  }
}
